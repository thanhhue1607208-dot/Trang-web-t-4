<!DOCTYPE html>
<html>
<head>
	<title>GIỚI THIỆU TỔ 4</title> 
	<meta charset="utf-8">
	<style>
		.banner {background:url("cong_truong(1).jpg") no-repeat center center;
						background-size: cover;
						padding-top:200px; 
						padding-bottom: 200px; 
						text-align: center !important;
						font-weight:bold; 
						font-size: 50px;
						color: red;
						font-family: Algerian;}
		.slogan{display:flex;}
		.row{width: 33%; 
						text-align: center;
						font-size: 25px;
						color:red;}
		.content{display:flex;}
		.khung {display:flex;
						display: flex;
    						/* Căn giữa theo chiều ngang */
    						justify-content: center; 
    						/* Căn giữa theo chiều dọc */
   					        align-items: center;
						border-radius: 20px;
						margin: 20px;
						padding: 15px;
						background-color: rgb(192,192,0); 
						font-size: 30px;
						height: 250px; 
						width: 900px;}
		.khung img{border-radius: 20px;
						width: 180px;
						height: auto; 
					margin-right: 100px;    /* Tạo khoảng cách ảnh – chữ */}
  		.khung p {margin:0;     /* Đẩy khối chữ lên gần giữa ảnh */}
		.footer {padding: 15px;
						background-color: rgb(255,165,0);
						font-size: 20px;
						text-align:center;}
		.box:hover {background-color: pink;}
		*{font-family: arial; "sans-serif" }
	</style>
</head>
<body>
	<div class="banner">TEAM FOUR 12A5</div>
	<div class="slogan">
		<div class="row">
			<h3>Chia sẻ</h3>
		</div>
		<div class="row">
			<h3>Hợp tác</h3>
		</div>
		<div class="row">
			<h3>Thành công</h3>
		</div>
	</div>
	<div class="content">
		<div class="khung box">
			<a href="https://cau-truc-web.netlify.app/">
				<img src="Trường.jpg" alt="Ảnh thành viên" width="500" height="700"></a>
 			<p>Cao Quốc Trường</p>
		</div>
		<div class="khung box">
			<a href="https://dothithanhhue1.netlify.app/">
				<img src="Huệ.jpg" alt="Ảnh thành viên"></a>
    		<p>Đỗ Thị Thanh Huệ</p>
		</div>
	</div>
	<div class="content">
		<div class="khung box">
			<a https://doanthitrucquynh.netlify.app/">
				<img src="Quỳnh.jpg" alt="Ảnh thành viên"></a>
    		<p>Đoàn Thị Trúc Quỳnh</p>
		</div>
		<div class="khung box">
			<a href="https://cau-truc-trang-web.netlify.app/">
				<img src="Trân.jpg" alt="Ảnh thành viên"></a>
    			<p>Lê Thị Quyền Trân</p>
		</div>
	</div>
	<div class="content">
		<div class="khung box">
			<a href="https://cau-truc-trang-web.netlify.app/">
				<img src="Công.jpg" alt="Ảnh thành viên"></a>
			<p>Mai Thành Công</p>
		</div>
		<div class="khung box">
			<a href="https://cau-truc-trang-web.netlify.app/">
				<img src="Định.jpg" alt="Ảnh thành viên"></a>
    			<p>Nguyễn Quốc Định</p>
		</div>
	</div>
	<div class="content">
		<div class="khung box">
			<a href="https://cau-truc-trang-web.netlify.app/">
				<img src="Ngân.jpg" alt="Ảnh thành viên"></a>
    			<p>Phạm Thu Ngân</p>
		</div>
<div class="khung box">
			<a href="https://cau-truc-trang-web.netlify.app/">
				<img src="Trận.jpg" alt="Ảnh thành viên"></a>
    			<p>Trần Xuân Trận</p>
  		</div>
	</div>
	<div class="content">
		<div class="khung box">
			<a href="https://github.com/qunnnkuyyyy1603-dot/duan2">
				<img src="Kỳ.jpg" alt="Ảnh thành viên"></a>
    			<p>Trương Quân Kỳ</p>
		</div>
		<div class="khung" style="background-color:white">	</div>
	</div>

	<div class="content">
		<div class="row">
			<h3>Góc ảnh Tổ 4</h3>
			<p><img src="Hoa hồng.jpg" alt="05/09" width="356" height="267"></p>
		</div>
		<div class="row">
			<h3>Video</h3>
			<p><video src="NGVN.mp4" controls width="356" height="267"></p>
		</div>
		<div class="row">
			<h3>Góc ảnh Tổ 4</h3>
			<p><img src="Hoa hồng.jpg" alt="05/09" width="356" height="267"></p>
		</div>
	</div>
    <div class="footer">
        <p>&copy; Copyright 2026. Tổ 4 - Lớp 12A5 </p>
